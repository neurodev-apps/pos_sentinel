<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard form -->
    <record id="view_pos_sentinel_justify_wizard_form" model="ir.ui.view">
        <field name="name">pos.sentinel.justify.wizard.form</field>
        <field name="model">pos.sentinel.justify.wizard</field>
        <field name="arch" type="xml">
            <form string="Justify Audit Event">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-exclamation-triangle" title="Warning"/> Justifying events does <strong>not</strong> alter their SHA-256 hash or remove them from the audit log. It only marks them as reviewed by you. The same note is applied to every selected event.
                    </div>

                    <!-- Skipped warning -->
                    <div class="alert alert-info" role="alert" invisible="skipped_count == 0">
                        <i class="fa fa-info-circle" title="Info"/>
                        <field name="skipped_count" class="d-inline" nolabel="1"/>
                        event(s) were already justified and will be skipped.
                    </div>

                    <group string="Selection">
                        <field name="is_bulk" invisible="1"/>
                        <field name="event_count"/>
                        <field name="summary_label" invisible="is_bulk"/>
                        <field name="risk_breakdown"/>
                    </group>

                    <!-- Event list (visible only in bulk) -->
                    <group invisible="not is_bulk">
                        <field name="event_ids" nolabel="1" colspan="2" readonly="1"
                               context="{'list_view_ref': 'pos_sentinel.view_pos_audit_event_list'}"/>
                    </group>

                    <group string="Justification">
                        <field name="justification_note"
                               placeholder="Explain why these events are not fraudulent (min. 10 characters)..."
                               nolabel="1"
                               colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Mark as Justified"
                            name="action_justify"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action: Bulk Justify (appears in list selection menu) -->
    <record id="action_pos_audit_event_bulk_justify" model="ir.actions.act_window">
        <field name="name">Bulk Justify</field>
        <field name="res_model">pos.sentinel.justify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_pos_audit_event"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
