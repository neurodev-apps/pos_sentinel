<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_sentinel_settings" model="ir.ui.view">
        <field name="name">pos.sentinel.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="POS Sentinel — Real-time Alerts"
                       name="pos_sentinel_alerts"
                       help="Send instant notifications when high-risk POS events are detected.">
                    <setting id="pos_sentinel_alert_enabled"
                             string="Enable real-time alerts"
                             help="When enabled, POS Sentinel will notify you immediately by email and/or webhook for any high-risk POS event.">
                        <field name="pos_sentinel_alert_enabled"/>
                    </setting>
                    <setting id="pos_sentinel_alert_threshold"
                             string="Alert Threshold"
                             help="Choose the minimum risk level that triggers an alert."
                             invisible="not pos_sentinel_alert_enabled">
                        <field name="pos_sentinel_alert_threshold"/>
                    </setting>
                    <setting id="pos_sentinel_alert_email_to"
                             string="Email Recipients"
                             help="Comma-separated list of email addresses to alert."
                             invisible="not pos_sentinel_alert_enabled">
                        <field name="pos_sentinel_alert_email_to"
                               placeholder="manager@yourcompany.com, owner@yourcompany.com"/>
                    </setting>
                    <setting id="pos_sentinel_alert_webhook_url"
                             string="Webhook URL"
                             help="Optional. POS Sentinel posts a JSON payload to this URL. Compatible with Slack, Telegram bots, Discord, and Twilio for WhatsApp/SMS."
                             invisible="not pos_sentinel_alert_enabled">
                        <field name="pos_sentinel_alert_webhook_url"
                               placeholder="https://hooks.slack.com/services/..."/>
                        <field name="pos_sentinel_alert_webhook_format"
                               string=" "
                               nolabel="1"/>
                    </setting>
                    <setting id="pos_sentinel_test_alert"
                             string="Test the alert configuration"
                             help="Send a sample alert to verify your email and webhook setup."
                             invisible="not pos_sentinel_alert_enabled">
                        <button string="Send Test Alert"
                                type="object"
                                name="action_pos_sentinel_test_alert"
                                class="btn-primary"
                                icon="fa-paper-plane"/>
                    </setting>
                </block>
                <block title="POS Sentinel — Margin Anomaly Detection"
                       name="pos_sentinel_margin"
                       help="Flag POS sales below cost or with abnormally low margin.">
                    <setting id="pos_sentinel_margin_evaluate_enabled"
                             string="Enable margin anomaly detection"
                             help="Each POS order line is evaluated. Sales below cost are flagged Critical. Sales below the threshold below are flagged Medium.">
                        <field name="pos_sentinel_margin_evaluate_enabled"/>
                    </setting>
                    <setting id="pos_sentinel_margin_threshold_pct"
                             string="Low-Margin Threshold (%)"
                             help="Margin percentage below which a Low Margin event is generated."
                             invisible="not pos_sentinel_margin_evaluate_enabled">
                        <field name="pos_sentinel_margin_threshold_pct"/>
                    </setting>
                    <setting id="pos_sentinel_margin_skip_zero_cost"
                             string="Skip products without cost"
                             help="Exclude products whose standard_price is 0 from evaluation."
                             invisible="not pos_sentinel_margin_evaluate_enabled">
                        <field name="pos_sentinel_margin_skip_zero_cost"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
