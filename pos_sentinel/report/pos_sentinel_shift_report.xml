<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_sentinel_shift_pdf" model="ir.actions.report">
        <field name="name">POS Sentinel Shift Report</field>
        <field name="model">pos.sentinel.shift.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_sentinel.report_sentinel_shift_pdf_template</field>
        <field name="report_file">pos_sentinel.report_sentinel_shift_pdf_template</field>
        <field name="print_report_name">'POS_Sentinel_Shift_%s' % object.pos_session_id.name.replace('/', '_')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
