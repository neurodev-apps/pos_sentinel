<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_sentinel_shift_pdf_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="d" t-value="data.get('report_data', {})"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Title -->
                        <h2 class="text-center mb-2">
                            <strong>POS Sentinel — Shift Report</strong>
                        </h2>
                        <p class="text-center text-muted mb-4" style="font-size: 0.9em;">
                            <t t-esc="d.get('company_name', '')"/>
                        </p>

                        <!-- Session meta -->
                        <div class="row mb-4">
                            <div class="col-7">
                                <table class="table table-sm table-borderless" style="width: auto;">
                                    <tr>
                                        <td class="fw-bold" style="min-width:110px;">Session:</td>
                                        <td><t t-esc="d.get('session_name', '')"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">POS:</td>
                                        <td><t t-esc="d.get('config_name', '')"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Status:</td>
                                        <td><t t-esc="d.get('session_state', '')"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Start:</td>
                                        <td><t t-esc="d.get('start_at', '')"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">End:</td>
                                        <td><t t-esc="d.get('stop_at', '') or 'Open'"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Duration:</td>
                                        <td><t t-esc="d.get('duration', '')"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-5 text-end">
                                <div style="display: inline-flex; gap: 12px;">
                                    <div class="p-2 border rounded text-center" style="min-width: 80px;">
                                        <div style="font-size: 1.8em; font-weight: bold; color: #312E81;">
                                            <t t-esc="d.get('total_events', 0)"/>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.8em;">Events</div>
                                    </div>
                                    <div class="p-2 border rounded text-center" style="min-width: 80px;">
                                        <div style="font-size: 1.8em; font-weight: bold; color: #7C3AED;">
                                            <t t-esc="d.get('total_score', 0)"/>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.8em;">Risk Score</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tampered alert -->
                        <t t-if="d.get('tampered', 0) > 0">
                            <div class="alert alert-danger text-center mb-4" role="alert">
                                <strong>⚠ INTEGRITY ALERT:</strong>
                                <t t-esc="d.get('tampered', 0)"/> record(s) with tampered hash detected.
                            </div>
                        </t>

                        <!-- Risk distribution -->
                        <h4 class="mt-3 mb-2" style="color: #312E81; border-bottom: 2px solid #312E81; padding-bottom: 4px;">
                            Risk Distribution
                        </h4>
                        <table class="table table-sm table-striped mb-4">
                            <thead>
                                <tr class="table-dark">
                                    <th>Risk Level</th>
                                    <th class="text-end">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="d.get('by_risk', [])" t-as="item">
                                    <tr>
                                        <td>
                                            <t t-if="item[0] == 'Critical'">
                                                <span class="badge bg-danger"><t t-esc="item[0]"/></span>
                                            </t>
                                            <t t-elif="item[0] == 'High'">
                                                <span class="badge bg-warning text-dark"><t t-esc="item[0]"/></span>
                                            </t>
                                            <t t-elif="item[0] == 'Medium'">
                                                <span class="badge bg-info text-dark"><t t-esc="item[0]"/></span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary"><t t-esc="item[0]"/></span>
                                            </t>
                                        </td>
                                        <td class="text-end"><t t-esc="item[1]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Per-cashier breakdown -->
                        <h4 class="mt-3 mb-2" style="color: #312E81; border-bottom: 2px solid #312E81; padding-bottom: 4px;">
                            By Cashier
                        </h4>
                        <table class="table table-sm" style="font-size: 0.85em;">
                            <thead>
                                <tr class="table-dark">
                                    <th>Cashier</th>
                                    <th class="text-end">Events</th>
                                    <th class="text-end">Voids</th>
                                    <th class="text-end">Disc.</th>
                                    <th class="text-end">Refunds</th>
                                    <th class="text-end">P.Overr.</th>
                                    <th class="text-end">Cash Out</th>
                                    <th class="text-end">Score</th>
                                    <th>Worst Risk</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="d.get('by_cashier', [])" t-as="row">
                                    <tr t-attf-style="#{row.get('worst_risk') in ('Critical','High') and 'background:#fde8e8;' or row.get('worst_risk') == 'Medium' and 'background:#fff8e1;' or ''}">
                                        <td><t t-esc="row.get('uname', '')"/></td>
                                        <td class="text-end"><t t-esc="row.get('total_events', 0)"/></td>
                                        <td class="text-end"><t t-esc="row.get('voids', 0)"/></td>
                                        <td class="text-end"><t t-esc="row.get('discounts', 0)"/></td>
                                        <td class="text-end"><t t-esc="row.get('refunds', 0)"/></td>
                                        <td class="text-end"><t t-esc="row.get('price_overrides', 0)"/></td>
                                        <td class="text-end"><t t-esc="row.get('cash_outs', 0)"/></td>
                                        <td class="text-end"><t t-esc="row.get('total_score', 0)"/></td>
                                        <td>
                                            <t t-if="row.get('worst_risk') == 'Critical'">
                                                <span class="badge bg-danger">Critical</span>
                                            </t>
                                            <t t-elif="row.get('worst_risk') == 'High'">
                                                <span class="badge bg-warning text-dark">High</span>
                                            </t>
                                            <t t-elif="row.get('worst_risk') == 'Medium'">
                                                <span class="badge bg-info text-dark">Medium</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary"><t t-esc="row.get('worst_risk', '')"/></span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Top risky events -->
                        <h4 class="mt-4 mb-2" style="color: #312E81; border-bottom: 2px solid #312E81; padding-bottom: 4px;">
                            Top Risk Events
                        </h4>
                        <table class="table table-sm" style="font-size: 0.82em;">
                            <thead>
                                <tr class="table-dark">
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Cashier</th>
                                    <th>Risk</th>
                                    <th class="text-end">Score</th>
                                    <th class="text-end">Amount</th>
                                    <th>Justified</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="d.get('top_events', [])" t-as="ev">
                                    <tr t-attf-style="#{ev.get('risk_level') in ('Critical','High') and 'background:#fde8e8;' or 'background:#fff8e1;'}">
                                        <td><t t-esc="ev.get('create_date', '')"/></td>
                                        <td><t t-esc="ev.get('event_type', '')"/></td>
                                        <td><t t-esc="ev.get('uname', '')"/></td>
                                        <td>
                                            <t t-if="ev.get('risk_level') == 'Critical'">
                                                <span class="badge bg-danger">Critical</span>
                                            </t>
                                            <t t-elif="ev.get('risk_level') == 'High'">
                                                <span class="badge bg-warning text-dark">High</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-info text-dark"><t t-esc="ev.get('risk_level', '')"/></span>
                                            </t>
                                        </td>
                                        <td class="text-end"><t t-esc="ev.get('risk_score', 0)"/></td>
                                        <td class="text-end"><t t-esc="ev.get('amount', 0)"/></td>
                                        <td><t t-if="ev.get('is_justified')">✓</t></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="text-center text-muted mt-5" style="font-size: 0.8em;">
                            Generated by POS Sentinel — Behavioral Fraud Detection
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
