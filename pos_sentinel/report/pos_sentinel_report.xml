<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report action for PDF generation -->
    <record id="action_report_sentinel_pdf" model="ir.actions.report">
        <field name="name">POS Sentinel Report</field>
        <field name="model">pos.sentinel.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_sentinel.report_sentinel_pdf_template</field>
        <field name="report_file">pos_sentinel.report_sentinel_pdf_template</field>
        <field name="print_report_name">'POS_Sentinel_Report_%s_%s' % (object.date_from.strftime('%Y%m%d'), object.date_to.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
